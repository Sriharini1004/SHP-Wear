#include <WiFi.h>
#include "DHTesp.h"
#include "ThingSpeak.h"
#include <LiquidCrystal_I2C.h>

/* ---------- PINS ---------- */
#define DHT_PIN     14
#define HEART_PIN   34
#define UV_PIN      35

#define GREEN_LED   19
#define YELLOW_LED  18
#define RED_LED     5
#define BUZZER      23

/* ---------- WIFI ---------- */
const char* ssid = "Wokwi-GUEST";
const char* password = "";

/* ---------- THINGSPEAK ---------- */
unsigned long channelID =  3215885;
const char* apiKey = "2GAV6YHV63P9HW24";

/* ---------- OBJECTS ---------- */
DHTesp dht;
WiFiClient client;
LiquidCrystal_I2C lcd(0x27, 16, 2);

/* ---------- VARIABLES ---------- */
float temperature, humidity;
int heartRate, uvValue;

/* ---------- SETUP ---------- */
void setup() {
  Serial.begin(115200);

  pinMode(GREEN_LED, OUTPUT);
  pinMode(YELLOW_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);
  pinMode(BUZZER, OUTPUT);

  dht.setup(DHT_PIN, DHTesp::DHT22);

  lcd.init();
  lcd.backlight();

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
  }

  ThingSpeak.begin(client);
}

/* ---------- LOOP ---------- */
void loop() {

  /* Read Sensors */
  TempAndHumidity data = dht.getTempAndHumidity();
  temperature = data.temperature;
  humidity = data.humidity;

  heartRate = map(analogRead(HEART_PIN), 0, 4095, 60, 140);
  uvValue   = analogRead(UV_PIN);

  lcd.clear();

  /* ---------- CONDITION CHECK ---------- */
  if (heartRate > 110 || temperature > 36 || uvValue > 2500) {
    // 🚨 DANGER
    lcd.clear();
    digitalWrite(RED_LED, HIGH);
    digitalWrite(YELLOW_LED, LOW);
    digitalWrite(GREEN_LED, LOW);
    digitalWrite(BUZZER, HIGH);

    lcd.setCursor(0, 0);
    lcd.print("DANGER ALERT!");
    lcd.setCursor(0, 1);
    lcd.print("Seek Help!");

  } else if (heartRate >= 90 || temperature >= 32) {
    // ⚠ WARNING
    lcd.clear();
    digitalWrite(YELLOW_LED, HIGH);
    digitalWrite(RED_LED, LOW);
    digitalWrite(GREEN_LED, LOW);
    digitalWrite(BUZZER, LOW);

    lcd.setCursor(0, 0);
    lcd.print("WARNING LEVEL");
    lcd.setCursor(0, 1);
    lcd.print("Take Care!");

  } else {
    // ✅ NORMAL
    lcd.clear();
    digitalWrite(GREEN_LED, HIGH);
    digitalWrite(RED_LED, LOW);
    digitalWrite(YELLOW_LED, LOW);
    digitalWrite(BUZZER, LOW);

    lcd.setCursor(0, 0);
    lcd.print("HR:");
    lcd.print(heartRate);
    lcd.print("bpm T:");
    lcd.print(temperature);
    lcd.print("C");

    lcd.setCursor(0, 1);
    lcd.print("UV:");
    lcd.print(uvValue);
    lcd.print(" H:");
    lcd.print(humidity);
    lcd.print("%");
  }

  /* ---------- THINGSPEAK ---------- */
  ThingSpeak.setField(1, heartRate);      // bpm
  ThingSpeak.setField(2, temperature);    // °C
  ThingSpeak.setField(3, humidity);       // %
  ThingSpeak.setField(4, uvValue);         // UV intensity
  ThingSpeak.writeFields(channelID, apiKey);

  /* ---------- SERIAL ---------- */
  Serial.println("Heart Rate: " + String(heartRate) + " bpm");
  Serial.println("Temperature: " + String(temperature) + " C");
  Serial.println("Humidity: " + String(humidity) + " %");
  Serial.println("UV Value: " + String(uvValue));
  Serial.println("----------------------");

  delay(15000);
}
